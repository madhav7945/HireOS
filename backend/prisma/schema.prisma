generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// MODELS
// ----------------------------------------------------------------------------

/// Represents a B2B tenant on the platform.
model Company {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  jobs  Job[]
  departments Department[]
  tasks       Task[]
  activities  Activity[]
  calendarEvents CalendarEvent[]
}

/// A human recruiter or admin.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  interviews Interview[] // Interviews they are scheduled to conduct

  @@index([companyId])
}

/// A job requisition with AI configuration logic.
model Job {
  id          String   @id @default(uuid())
  title       String
  department  String?
  description String
  status      String   @default("OPEN") // OPEN, CLOSED, DRAFT
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 5D AI Weighting
  weightTechnical     Int @default(20)
  weightExperience    Int @default(20)
  weightScreening     Int @default(20)
  weightEducation     Int @default(20)
  weightCommunication Int @default(20)

  // Hard Knockout Rules
  minExperienceYears Int     @default(0)
  requireWorkAuth    Boolean @default(false)

  candidates Candidate[]

  @@index([companyId])
  @@index([status])
}

/// A candidate applying for a job.
model Candidate {
  id         String  @id @default(uuid())
  firstName  String
  lastName   String
  email      String
  resumeUrl  String? // Link to PDF in Supabase Storage
  parsedText String? // Raw text extracted via pdf.js

  stage          String  @default("APPLIED")
  knockoutReason String? // E.g., "Requires Sponsorship"

  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  score      CandidateScore?
  interviews Interview[]
  offer      Offer?

  @@unique([email, jobId]) // A candidate can only apply to a specific job once
  @@index([jobId])
  @@index([stage])
}

/// The 5-Dimensional AI Groq Scorecard for a Candidate's resume.
model CandidateScore {
  id          String    @id @default(uuid())
  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  technical     Int
  experience    Int
  screening     Int
  education     Int
  communication Int

  compositeScore Float // The final weighted average calculated by semanticScorer

  createdAt DateTime @default(now())
}

/// Represents either a Live AI Interview session or an HR manual session.
model Interview {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  isAiInterview Boolean         @default(true)
  status        String  @default("PENDING")

  magicToken  String?   @unique // 256-bit hash for joining the WebSocket room
  meetingLink String?
  scheduledAt DateTime?
  completedAt DateTime?

  // For HR Interviews
  hrInterviewerId String?
  hrInterviewer   User?   @relation(fields: [hrInterviewerId], references: [id])

  transcript String? // The full chat log generated by Whisper + Llama
  feedback   String? // AI generated summary of the interview performance

  createdAt DateTime @default(now())
  messages  InterviewMessage[]

  @@index([candidateId])
  @@index([status])
}

/// Digital Offer letter generated and tracked for cryptographic e-signing.
model Offer {
  id          String    @id @default(uuid())
  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  baseSalary Float
  equity     Float?
  bonus      Float?

  magicToken String @unique
  status     String @default("PENDING") // PENDING, SIGNED, EXPIRED

  signatureHash String? // SHA-256 Hash of signature + timestamp + IP
  signedAt      DateTime?

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// NEW MIGRATION MODELS (PHASE 6)
// ----------------------------------------------------------------------------

model Department {
  id        String   @id @default(uuid())
  name      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Task {
  id        String   @id @default(uuid())
  text      String
  dueDate   DateTime?
  done      Boolean  @default(false)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Activity {
  id          String   @id @default(uuid())
  entityType  String?
  entityId    String?
  action      String
  details     Json?
  
  // Flattened for easy UI
  type        String?
  icon        String?
  user        String?
  target      String?
  module      String?

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@index([companyId])
}

model CalendarEvent {
  id          String   @id @default(uuid())
  title       String?
  candidate   String?
  role        String?
  date        String?
  time        String?
  type        String?
  interviewer String?
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())

  @@index([companyId])
}

model InterviewMessage {
  id          String    @id @default(uuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  sender      String
  content     String
  timestamp   DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([interviewId])
}
