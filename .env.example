# Supabase Configuration
# Go to https://supabase.com → New Project (Free tier)
# Copy these values from Settings → API
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Calendar API (Free)
# 1. Go to https://console.cloud.google.com
# 2. Create a new project (or select existing)
# 3. Enable "Google Calendar API" under APIs & Services
# 4. Create credentials → OAuth 2.0 Client ID → Web Application
# 5. Add http://localhost:5173 to Authorized JavaScript origins
# 6. Create API Key under Credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-google-api-key

# ============================================================
# AI Interview Engine (OpenAI-compatible — Groq / OpenAI / OpenRouter)
# ============================================================
# The AI Interview Room uses these to run a REAL LLM interviewer + scoring.
# Easiest + free: get a Groq key at https://console.groq.com  → paste below.
#
# Paste your key here:
VITE_AI_API_KEY=your-api-key
# Optional overrides (defaults shown):
# VITE_AI_BASE_URL=https://api.groq.com/openai/v1
# VITE_AI_MODEL=llama-3.3-70b-versatile
#
# To use OpenAI instead:
#   VITE_AI_BASE_URL=https://api.openai.com/v1
#   VITE_AI_MODEL=gpt-4o-mini

# Legacy key (still works as a fallback for AI candidate screening)
VITE_GROQ_API_KEY=your-groq-api-key

# ============================================================
# Email delivery (real, via the send-email Supabase Edge Function + Resend)
# ============================================================
# 1. Get a key at https://resend.com → API Keys
# 2. supabase functions deploy send-email
# 3. supabase secrets set RESEND_API_KEY=re_xxx
# 4. (optional) supabase secrets set EMAIL_FROM="HireOS <noreply@yourdomain.com>"
#
# Frontend "from" label (optional; the server secret EMAIL_FROM takes precedence):
# VITE_EMAIL_FROM=HireOS <onboarding@resend.dev>
#
# If the function isn't deployed, the app degrades to an honest no-delivery stub.
